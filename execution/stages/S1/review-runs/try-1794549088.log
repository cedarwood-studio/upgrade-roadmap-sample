# frozen_string_literal: true

require "socket"
require "tempfile"
require "timeout"

module ProcessHelpers

  # Run one of the scripts in script/ as a child process for the duration of
  # the block. The child is killed if it is still running when the block ends.
  def run_script(script, env = {})
    output = Tempfile.new("postal-process")
    pid = Process.spawn(env.transform_values(&:to_s), "bundle", "exec", "ruby", script,
                        chdir: Rails.root.to_s, out: output.path, err: [:child, :out])
    yield pid, output
  ensure
    kill_process(pid) if pid
    output&.close!
  end

  def kill_process(pid)
    return unless Process.waitpid(pid, Process::WNOHANG).nil?

    Process.kill("KILL", pid)
    Process.wait(pid)
  rescue Errno::ECHILD
    # The process has already exited and been waited for.
  end

  # Send TERM to the process and return its exit status
  def terminate_process(pid, timeout: 30)
    Process.kill("TERM", pid)
    Timeout.timeout(timeout) { Process.wait2(pid).last }
  end

  def free_port
    server = TCPServer.new("127.0.0.1", 0)
    server.addr[1]
  ensure
    server&.close
  end

  def wait_until(timeout: 60, interval: 0.2)
    deadline = Process.clock_gettime(Process::CLOCK_MONOTONIC) + timeout
    loop do
      result = yield
      return result if result
      raise "timed out after #{timeout} seconds" if Process.clock_gettime(Process::CLOCK_MONOTONIC) > deadline

      sleep interval
    end
  end

  def connect_when_listening(port, **options)
    wait_until(**options) do
      TCPSocket.new("127.0.0.1", port)
    rescue Errno::ECONNREFUSED
      nil
    end
  end

  def health_check(port, **options)
    socket = connect_when_listening(port, **options)
    socket.write("GET /health HTTP/1.0\r\n\r\n")
    socket.read
  ensure
    socket&.close
  end

end
# frozen_string_literal: true

require "rails_helper"

module SMTPServer

  describe Server do
    include ProcessHelpers

    describe "running script/smtp_server.rb" do
      let(:port) { free_port }
      let(:health_server_port) { free_port }

      it "boots, serves a client and shuts down on TERM" do
        env = { "BIND_ADDRESS" => "127.0.0.1", "PORT" => port, "HEALTH_SERVER_PORT" => health_server_port }
        run_script("script/smtp_server.rb", env) do |pid, output|
          socket = connect_when_listening(port)
          expect(socket.gets).to match(/\A220 #{Regexp.escape(Postal::Config.postal.smtp_hostname)} ESMTP Postal\/\S+\r\n\z/)
          socket.write("QUIT\r\n")
          expect(socket.gets).to eq "221 Closing Connection\r\n"
          socket.close

          response = health_check(health_server_port)
          expect(response).to start_with("HTTP/1.1 200 OK")
          expect(response).to end_with("OK")

          status = terminate_process(pid)
          expect(status.exitstatus).to eq 0
          expect(output.read).to include("Received TERM signal, shutting down.")
        end
      end
    end
  end

end
# frozen_string_literal: true

require "rails_helper"

module Worker

  describe Process do
    include ProcessHelpers

    describe "running script/worker.rb" do
      # The worker is another process, so what it writes is only visible, and
      # can only be removed, outside of a test transaction.
      self.use_transactional_tests = false

      let(:health_server_port) { free_port }
      let(:task_names) { described_class::TASKS.map(&:to_s) }

      def remove_worker_records
        ScheduledTask.where(name: task_names).delete_all
        WorkerRole.where(role: "tasks").delete_all
      end

      before { remove_worker_records }
      after { remove_worker_records }

      it "boots, acquires the tasks role, schedules every task and shuts down on TERM" do
        run_script("script/worker.rb", { "HEALTH_SERVER_PORT" => health_server_port }) do |pid, output|
          response = health_check(health_server_port)
          expect(response).to start_with("HTTP/1.1 200 OK")
          expect(response).to end_with("OK")

          wait_until { ScheduledTask.where(name: task_names).count == task_names.size }
          expect(ScheduledTask.where(name: task_names).pluck(:next_run_after)).to all(be > Time.current)
          expect(WorkerRole.where(role: "tasks").count).to eq 1

          status = terminate_process(pid)
          expect(status.exitstatus).to eq 0
          expect(output.read).to include("Received TERM signal. Stopping when able.")
          expect(WorkerRole.where(role: "tasks").count).to eq 0
        end
      end
    end
  end

end
