diff --git a/spec/lib/migration_waiter_spec.rb b/spec/lib/migration_waiter_spec.rb
new file mode 100644
index 0000000..80d3b96
--- /dev/null
+++ b/spec/lib/migration_waiter_spec.rb
@@ -0,0 +1,40 @@
+# frozen_string_literal: true
+
+require "rails_helper"
+require "migration_waiter"
+
+RSpec.describe MigrationWaiter do
+  describe ".wait" do
+    it "returns when there are no pending migrations" do
+      expect(Process).not_to receive(:exit)
+      expect(Postal.logger).to receive(:info).with("no pending migrations, continuing")
+      expect { described_class.wait }.not_to raise_error
+    end
+
+    it "exits when migrations are still pending after the configured attempts" do
+      migrator = instance_double(ActiveRecord::Migrator, pending_migrations: [double("migration")])
+      context = instance_double(ActiveRecord::MigrationContext, open: migrator)
+      allow(ActiveRecord::Base.connection_pool).to receive(:migration_context).and_return(context)
+      allow(described_class).to receive(:sleep)
+      allow(Process).to receive(:exit).with(1).and_raise(SystemExit)
+
+      expect { described_class.wait }.to raise_error(SystemExit)
+      expect(described_class).to have_received(:sleep).with(described_class::SLEEP_TIME).exactly(described_class::ATTEMPTS - 1).times
+    end
+  end
+
+  describe ".wait_if_appropriate" do
+    it "does not wait when the migration waiter is not enabled" do
+      allow(Postal::Config.migration_waiter).to receive(:enabled?).and_return(false)
+      expect(described_class).not_to receive(:wait)
+      described_class.wait_if_appropriate
+    end
+
+    it "waits when enabled outside the console, rake tasks and rails commands" do
+      allow(Postal::Config.migration_waiter).to receive(:enabled?).and_return(true)
+      allow(described_class).to receive_messages(console?: false, rake_task?: false, rails_command?: false)
+      expect(described_class).to receive(:wait)
+      described_class.wait_if_appropriate
+    end
+  end
+end
diff --git a/spec/lib/secret_key_spec.rb b/spec/lib/secret_key_spec.rb
new file mode 100644
index 0000000..be403bb
--- /dev/null
+++ b/spec/lib/secret_key_spec.rb
@@ -0,0 +1,13 @@
+# frozen_string_literal: true
+
+require "rails_helper"
+
+# config/initializers/secret_key.rb puts the key in the credentials, and Rails
+# reads it from there in every environment. Because the credentials value is
+# always set, Rails never falls back to a generated tmp/local_secret.txt.
+RSpec.describe "The secret key base" do
+  it "is the key the initializer put in the credentials" do
+    expect(Rails.application.credentials.secret_key_base).to be_present
+    expect(Rails.application.secret_key_base).to eq Rails.application.credentials.secret_key_base
+  end
+end
diff --git a/spec/requests/error_pages_spec.rb b/spec/requests/error_pages_spec.rb
new file mode 100644
index 0000000..5b5442c
--- /dev/null
+++ b/spec/requests/error_pages_spec.rb
@@ -0,0 +1,51 @@
+# frozen_string_literal: true
+
+require "rails_helper"
+
+# The test environment raises exceptions instead of rendering them, so no other
+# request spec reaches the static error pages. These examples switch rendering
+# on, the way production runs, and pin what a client receives for a path that
+# does not exist. Since Rails 7.2.3 a HEAD request that ends in an error page is
+# answered with an empty body in the format the request asked for; before that
+# it was answered with the headers of the HTML page.
+RSpec.describe "Error pages", type: :request do
+  around do |example|
+    env_config = Rails.application.env_config
+    original = env_config.slice("action_dispatch.show_exceptions", "action_dispatch.show_detailed_exceptions")
+    env_config["action_dispatch.show_exceptions"] = :all
+    env_config["action_dispatch.show_detailed_exceptions"] = false
+    example.run
+  ensure
+    env_config.merge!(original)
+  end
+
+  let(:not_found_page) { Rails.public_path.join("404.html").read }
+
+  describe "GET a path that does not exist" do
+    it "renders the static 404 page" do
+      get "/no/such/page", headers: { "Accept" => "*/*" }
+      expect(response).to have_http_status(:not_found)
+      expect(response.headers["Content-Type"]).to eq "text/html; charset=UTF-8"
+      expect(response.headers["Content-Length"]).to eq not_found_page.bytesize.to_s
+      expect(response.body).to eq not_found_page
+    end
+  end
+
+  describe "HEAD a path that does not exist" do
+    it "answers 404 with an empty body in the requested format" do
+      head "/no/such/page", headers: { "Accept" => "*/*" }
+      expect(response).to have_http_status(:not_found)
+      expect(response.headers["Content-Type"]).to eq "*/*; charset=UTF-8"
+      expect(response.headers["Content-Length"]).to eq "0"
+      expect(response.body).to eq ""
+    end
+
+    it "keeps the HTML content type for a client that asks for HTML" do
+      head "/no/such/page", headers: { "Accept" => "text/html" }
+      expect(response).to have_http_status(:not_found)
+      expect(response.headers["Content-Type"]).to eq "text/html; charset=UTF-8"
+      expect(response.headers["Content-Length"]).to eq "0"
+      expect(response.body).to eq ""
+    end
+  end
+end
